# Token del bot de Telegram (se obtiene hablándole a @BotFather en Telegram: /newbot)
TELEGRAM_BOT_TOKEN=

# API key de Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Datos de la empresa que reporta el 606
EMPRESA_RNC=131667023
EMPRESA_NOMBRE=Bortech

# ID de chat de Telegram de mamá (para que el bot solo responda a ella).
# Se obtiene enviándole un mensaje al bot y mirando el log del primer update,
# o hablándole a @userinfobot en Telegram.
TELEGRAM_CHAT_ID_AUTORIZADO=

# Carpeta donde se guardan los .xlsx mensuales generados.
# Déjala vacía/comentada para que use por defecto la carpeta "datos" junto al
# programa (junto al .exe si es la versión compilada para Windows).
#CARPETA_DATOS=./datos

# Carpeta que la app de escritorio (app.py) vigila para detectar facturas nuevas.
# Por defecto la carpeta de Descargas, ya que ahí caen los adjuntos guardados
# desde WhatsApp Web o el correo. Cambia esto si prefieres usar otra carpeta.
CARPETA_VIGILADA=~/Downloads
